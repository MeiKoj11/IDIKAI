# Copy this file to .env and fill in your real values.
# Never commit the real .env — it's already in .gitignore.

ANTHROPIC_API_KEY=your-key-here

# Creates your own account the very first time the server starts with
# an empty database (ignored after any account exists — safe to leave
# these set permanently). See server/README.md for details.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=pick-a-real-password

# Where the SQLite database file lives. Leave unset for local dev (it
# defaults to server/data.db). On Render, set this to a path under
# your attached persistent disk's mount point, e.g. /var/data/app.db —
# otherwise all accounts/data reset on every deploy.
# DB_PATH=/var/data/app.db
